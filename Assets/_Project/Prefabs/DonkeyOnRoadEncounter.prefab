  descriptionText: "\u041A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D
    \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A \u0435\u0433\u043E
    \u043B\u0430\u0434\u043E\u043D\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F
    \u0437\u043E\u043B\u043E\u0442\u043E\u043C: \"\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u0432\u0430\u043C, \u0449\u0435\u0434\u0440\u044B\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D!\".
    \"\u0421\u043F\u0430\u0441\u0438\u0431\u043A\u0438, \u044F \u043F\u043E\u0448\u0435\u043B!\""
