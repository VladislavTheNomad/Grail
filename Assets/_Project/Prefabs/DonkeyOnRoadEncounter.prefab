--- !u!114 &1615825814771806312
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1574839705467995353}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abf72077f89372845b8830fa0826a16e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  descriptionText: "\u0412\u044B \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0435\u0442\u0435
    \u043E\u0441\u043B\u0430 \u0438\u0437 \u043A\u0430\u043D\u0430\u0432\u044B. \u0423\u043F\u0440\u044F\u043C\u043E\u0435
    \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435,
    \u0447\u0435\u043C \u0432\u044B \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438,
    \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
    \u043F\u043E\u0440\u044F\u0434\u043E\u0447\u043D\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u043D\u043E \u0432\u0441\u0435 \u0436\u0435 \u0432\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C
    \u043F\u043E\u043C\u043E\u0447\u044C \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D\u0443.
    \u0421\u0445\u0432\u0430\u0442\u0438\u0432 \u043E\u043E\u0441\u043B\u0430 \u043F\u043E\u0434
    \u0443\u0437\u0434\u0446\u044B, \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D
    \u0431\u044B\u0441\u0442\u0440\u043E \u0437\u0430\u0441\u0435\u043C\u0435\u043D\u0438\u043B
    \u043F\u0440\u043E\u0447\u044C, \u043F\u043E\u043A\u0430 \u0432\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
    \u0438\u0437 \u044F\u043C\u044B, \u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0435
    \u0433\u0440\u044F\u0437\u044C\u044E \u0438 \u043F\u0435\u0441\u043A\u043E\u043C.
    \u0414\u0430\u0436\u0435 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B \u0441\u043F\u0430\u0441\u0438\u0431\u043E!
    \u041E\u0431\u0438\u0434\u043D\u043E..."
  buttonsTexts:
  - "\u041E\u043A"
  buttonActions:
  - m_PersistentCalls:
      m_Calls: []
