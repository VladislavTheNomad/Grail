  m_Name: a2_DonkeyOnRoad 1
  m_EditorClassIdentifier: 
  descriptionText: "\u0412\u044B \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0435\u0442\u0435
    \u043E\u0441\u043B\u0430 \u0438\u0437 \u043A\u0430\u043D\u0430\u0432\u044B. \u0423\u043F\u0440\u044F\u043C\u043E\u0435
    \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435,
    \u0447\u0435\u043C \u0432\u044B \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438,
    \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
    \u043F\u043E\u0440\u044F\u0434\u043E\u0447\u043D\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u043D\u043E \u0432\u0441\u0435 \u0436\u0435 \u0432\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C
    \u043F\u043E\u043C\u043E\u0447\u044C \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D\u0443."
